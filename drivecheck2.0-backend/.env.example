# Copied to .env (gitignored) and used only by local SAM invokes.
# Production values live in AWS Secrets Manager.

AWS_REGION=ap-south-1
OWNER_TAG=chittaranjan1998.das@gmail.com

# Used by `sam deploy` to seed the OpenAI secret on first deploy.
# After deploy, rotate it directly in Secrets Manager and remove from .env.
OPENAI_API_KEY=

# Set after first deploy — grab from the SAM outputs.
API_BASE_URL=
API_KEY=
