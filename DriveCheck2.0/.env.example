# DriveCheck app config. Fill in after the backend stack is deployed
# (drivecheck-backend → `npm run deploy:dev`).
#
# OPENAI_API_KEY / ELEVENLABS_API_KEY / AWS_* are NOT here on purpose —
# they live server-side in AWS Secrets Manager and are only used by the
# Lambdas. The app only needs to know the API Gateway URL + key.

API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev
API_KEY=<from `aws apigateway get-api-key --api-key <id> --include-value`>

# AppSync real-time subscription for the home page's inspection list.
# Both come from the `sam deploy` outputs (RealtimeGraphQLUrl + RealtimeApiKey).
APPSYNC_HTTPS_URL=https://<appsync-id>.appsync-api.ap-south-1.amazonaws.com/graphql
APPSYNC_API_KEY=da2-<appsync-api-key>
